# FullAuth JWT (https://fullcreative.fullauth.com). ~2h TTL — expect to refresh it between runs.
# Same token authenticates BOTH the task API and the history API.
DS_ACCESS_TOKEN=

# Parent DS account id. Not a secret; the JWT is.
